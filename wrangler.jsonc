{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "virelox-media",
  "main": "./src/worker.js",
  "compatibility_date": "2026-09-23",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "send_email": [
    {
      "name": "EMAIL",
      "destination_address": "caleb@vireloxmedia.com",
      "allowed_sender_addresses": ["website@vireloxmedia.com"]
    }
  ]
}
